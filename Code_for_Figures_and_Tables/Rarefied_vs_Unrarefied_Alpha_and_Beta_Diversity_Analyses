# Check required columns
required_cols <- c("Sample_ID", "Species", "Site", "Month", "TreeID")
missing_cols <- setdiff(required_cols, colnames(metadata))
if (length(missing_cols) > 0) {
  stop(
    paste(
      "Metadata is missing required columns:",
      paste(missing_cols, collapse = ", ")
    )
  )
}

# Keep shared samples only
shared_samples <- intersect(otu_t$Sample_ID, metadata$Sample_ID)

otu_t <- otu_t[otu_t$Sample_ID %in% shared_samples, , drop = FALSE]
metadata <- metadata[metadata$Sample_ID %in% shared_samples, , drop = FALSE]

# Reorder metadata to match OTU table
metadata <- metadata[match(otu_t$Sample_ID, metadata$Sample_ID), , drop = FALSE]

