metadata_clean <- metadata[rownames(otu_rarefied_clean), ]

# Final alignment check
stopifnot(identical(rownames(otu_rarefied_clean), rownames(metadata_clean)))

# -------------------------------
# Step 4: Export rarefied OTU table
# -------------------------------
