otu_path <- "/Users/cbivins/Desktop/Oak_Endophyte_Project_NEATEST/NEW/otu_table_raw.csv"
meta_path <- "/Users/cbivins/Desktop/Oak_Endophyte_Project_NEATEST/NEW/metadata.csv"
