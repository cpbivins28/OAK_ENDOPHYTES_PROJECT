# Confirm matching samples
shared_samples <- intersect(meta$Sample_ID, colnames(otu))
otu <- otu[, shared_samples]
meta <- meta[match(shared_samples, meta$Sample_ID), ]

# ------------------------
# Calculate Simpson diversity
# ------------------------
otu_t <- as.data.frame(t(otu))
otu_t[] <- lapply(otu_t, as.numeric)

meta$Simpson <- diversity(otu_t, index = "simpson")

# Add Tree_ID column if not already present
if (!"Tree_ID" %in% colnames(meta)) {
  meta$Tree_ID <- gsub("([A-Z]+-\\d+)-.*", "\\1", meta$Sample_ID)
}

# Export per-sample Simpson values
simpson_out <- meta %>%
  select(Sample_ID, Tree_ID, Species, Site, Month, Simpson)

write.csv(simpson_out, file.path(output_dir, "simpson_diversity_values.csv"), row.names = FALSE)

# ------------------------
# Run LMMs
# ------------------------
models <- list(
  Species = lmer(Simpson ~ Species + (1 | Tree_ID), data = meta),
  Month   = lmer(Simpson ~ Month + (1 | Tree_ID), data = meta),
  Site    = lmer(Simpson ~ Site + (1 | Tree_ID), data = meta)
)

# Combine ANOVA results
model_summaries <- lapply(models, function(m) {
  anova(m, type = 3) %>%
    as.data.frame() %>%
    rownames_to_column("Effect")
})

model_df <- bind_rows(model_summaries, .id = "Model")
write.csv(model_df, file.path(output_dir, "figure1_lmm_results.csv"), row.names = FALSE)

# ------------------------
# Post-hoc Tukey test for Month
# ------------------------
month_emm <- emmeans(models$Month, pairwise ~ Month, adjust = "tukey")
tukey_df <- as.data.frame(month_emm$contrasts)
write.csv(tukey_df, file.path(output_dir, "figure1_month_posthoc.csv"), row.names = FALSE)
