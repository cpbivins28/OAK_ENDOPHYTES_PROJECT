rownames(metadata) <- metadata$Sample_ID

# Subset metadata to match OTU table
metadata <- metadata[rownames(otu_raw_t), ]

# Confirm alignment
stopifnot(identical(rownames(otu_raw_t), rownames(metadata)))  # Should return TRUE

# -------------------------------
# Step 3: Rarefy OTU Table
# -------------------------------
rarefaction_depth <- 1100
set.seed(42)  # For reproducibility

otu_rarefied <- rrarefy(otu_raw_t, sample = rarefaction_depth)

# Drop samples that failed rarefaction (just in case)
