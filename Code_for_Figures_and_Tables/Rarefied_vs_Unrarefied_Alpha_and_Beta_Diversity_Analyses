# First column is OTU ID
rownames(otu_mat) <- otu_mat[[1]]
otu_mat <- otu_mat[, -1, drop = FALSE]

# Standardize sample names in OTU table to dots
colnames(otu_mat) <- gsub("-", ".", colnames(otu_mat))

# Transpose so rows = samples, cols = OTUs
otu_t <- as.data.frame(t(otu_mat))
otu_t[] <- lapply(otu_t, as.numeric)
otu_t$Sample_ID <- rownames(otu_t)

# -----------------------------------------------------------------------------
# 4. Prepare metadata
# -----------------------------------------------------------------------------
# Drop unnamed first column if present
if ("...1" %in% colnames(metadata)) {
  metadata <- metadata[, colnames(metadata) != "...1", drop = FALSE]
}

# Make sure Sample_ID exists
